# Meros environment variables. Copy to .env (or run `pnpm setup:env`, which fills secrets for you).
# .env is never committed.

# --- Database (Neon Postgres for local dev; Azure PostgreSQL Flexible Server in production) ---
# Pooled connection used by the app at runtime (Neon host contains "-pooler").
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection used by `prisma migrate`.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require
# For docker compose later: DATABASE_URL=postgresql://meros:meros@postgres:5432/meros (same for DIRECT_URL)

# --- Security (generated by `pnpm setup:env`; Azure Key Vault in production) ---
# 32 random bytes, base64. Wraps each user's data key (AES-256-GCM field encryption).
ENCRYPTION_MASTER_KEY=
# At least 32 characters. Signs the demo session cookie.
SESSION_SECRET=
# Ed25519 keys (hex) of the simulated licensed screening lab. The app only needs the public key.
# The private key exists here only so `pnpm seed` can play the role of the lab.
LAB_SIGNING_PUBLIC_KEY=
LAB_SIGNING_PRIVATE_KEY=

# --- Demo ---
# Enables the persona picker login. Production uses UAE Pass (see docs/ARCHITECTURE.md).
DEMO_MODE=true

# --- AI and later phases ---
# Genetic Copilot. mock = offline demo model (no key). anthropic = Claude through the Anthropic API.
AI_PROVIDER=mock
AI_API_KEY=
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=
# Optional custom endpoint (for example a gateway). Leave empty for the Anthropic API.
AI_ENDPOINT=
# Optional: low (default, fastest), medium or high.
AI_EFFORT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
ACS_CONNECTION_STRING=
BLOB_CONNECTION_STRING=
NCBI_API_KEY=
# Genomics service (Risk Beyond the Panel) is postponed to Phase 5.
GENOMICS_SERVICE_URL=

# Local demo only: set to false to sign in over plain http from another device on the same Wi-Fi
# (docker compose sets this for you). Leave unset on any deployed environment.
# COOKIE_SECURE=false
